{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": { "driver": { "name": "CodeQL" } },
      "results": [
        {
          "ruleId": "js/sql-injection",
          "level": "error",
          "message": { "text": "SQL injection sink." },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": { "uri": "src/db.js" },
                "region": { "startLine": 42 }
              }
            },
            {
              "physicalLocation": {
                "artifactLocation": { "uri": "src/api.js" },
                "region": { "startLine": 10 }
              }
            }
          ],
          "properties": { "tags": ["security", "CWE-89"] }
        }
      ]
    }
  ]
}
